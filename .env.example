# Copy to .env and change for any shared or public deployment.
POSTGRES_PASSWORD=change-me
ACCOUNTS_DB_PASSWORD=change-me-too
SHARD_DB_PASSWORD=change-me-three

# Where players reach the game; OAuth redirects come back here.
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# Optional sign-in providers. Leave empty to disable.
# Discord: https://discord.com/developers/applications  (redirect: $PUBLIC_URL/auth/oauth/discord/callback)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials  (redirect: $PUBLIC_URL/auth/oauth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
